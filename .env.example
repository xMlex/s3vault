# s3vault environment variables
# CLI does not load this file automatically:
#   set -a && source .env && set +a
# Integration tests load ./.env when present.
#
# Mapping: config key a.b_c → S3VAULT_A_B_C
# Precedence: flags > env > YAML > defaults

# --- logging ---
# S3VAULT_LOG_LEVEL=info

# --- backend ---
# s3 (default) | local
# S3VAULT_BACKEND_TYPE=s3
# local only: object tree on this host; s3.* is then unused
# S3VAULT_BACKEND_LOCAL_DIR=/srv/s3vault/objects
# Форма объекта задаётся только S3VAULT_ENCRYPTION_MODE, на любом бэкенде:
#   none    — голый payload, без контейнера S3VCTR01
#   native  — S3VCTR01(enc=native)  || S3VLT01…
#   command — S3VCTR01(enc=command) || шифротекст
# Ключа S3VAULT_BACKEND_LOCAL_LAYOUT больше нет — он удалён и отвергается на старте.

# --- S3 ---
S3VAULT_S3_ENDPOINT=http://s3.local.domain.com/
S3VAULT_S3_REGION=us-east-1
S3VAULT_S3_BUCKET=test
S3VAULT_S3_PREFIX=
S3VAULT_S3_PATH_STYLE=true
# TLS определяется схемой S3VAULT_S3_ENDPOINT: https:// — с проверкой
# сертификата, http:// — без TLS. Отдельного S3VAULT_S3_TLS нет.
S3VAULT_S3_ACCESS_KEY=test
S3VAULT_S3_SECRET_KEY=testtesttesttesttesttesttesttest
# S3VAULT_S3_SESSION_TOKEN=
# S3VAULT_S3_ALLOW_SECRETS_IN_CONFIG=false
# If access/secret empty, AWS SDK default chain is used (AWS_ACCESS_KEY_ID, ~/.aws/credentials, …).

# --- encryption ---
# none | native | command
# S3VAULT_ENCRYPTION_MODE=none
# native: rsa-oaep | keyfile
# S3VAULT_ENCRYPTION_NATIVE_WRAP=rsa-oaep
# S3VAULT_ENCRYPTION_NATIVE_PUBLIC_KEY_PATH=/etc/s3vault/public.pem
# S3VAULT_ENCRYPTION_NATIVE_PRIVATE_KEY_PATH=/etc/s3vault/private.pem
# S3VAULT_ENCRYPTION_NATIVE_KEY_FILE=/etc/s3vault/kek.bin
# S3VAULT_ENCRYPTION_NATIVE_CHUNK_SIZE=65536
# CryptoPro / command mode (thumbprint is not a secret):
# S3VAULT_ENCRYPTION_COMMAND_PROVIDER=cryptopro
# S3VAULT_ENCRYPTION_COMMAND_THUMBPRINT=afa43c43975fbfc700f051fd62016e1571e7e025
# S3VAULT_ENCRYPTION_COMMAND_TIMEOUT=30m
# encrypt/decrypt argv lists: prefer YAML (env slice binding is awkward)
# S3VAULT_ENCRYPTION_COMMAND_ENCRYPT=
# S3VAULT_ENCRYPTION_COMMAND_DECRYPT=

# --- CryptoPro wrappers (scripts/cryptcp-*; not S3VAULT_*) ---
# CRYPTOPRO_PIN=
# CRYPTOPRO_THUMBPRINT=   # usually set by s3vault from object metadata on decrypt
# CRYPTCP=/opt/cprocsp/bin/amd64/cryptcp

# --- cache (server / materialize) ---
# S3VAULT_CACHE_ENABLED=false
# S3VAULT_CACHE_DIR=
# S3VAULT_CACHE_TTL=168h
# S3VAULT_CACHE_SOFT_TTL=20s
# S3VAULT_CACHE_SWEEP_INTERVAL=15m
# S3VAULT_CACHE_MAX_BYTES=10737418240

# --- HTTP server ---
# S3VAULT_SERVER_LISTEN=127.0.0.1:8080
# S3VAULT_SERVER_METRICS_LISTEN=127.0.0.1:9090
# The gateway serves clients only over the S3 API; server.token / HTTP /files
# were removed. A non-loopback or loopback server both require the S3 keys below.

# --- S3 API facade (SigV4) ---
# Both keys required: this is the gateway's only data frontend. Prefer env over YAML.
# Frontend keys are independent of the backend S3VAULT_S3_ACCESS_KEY above.
# S3VAULT_SERVER_S3_LISTEN=  # empty = multiplex on listen; reserved /health /ready
# S3VAULT_SERVER_S3_LISTEN=127.0.0.1:8333  # or a dedicated port
# S3VAULT_SERVER_S3_ACCESS_KEY=
# S3VAULT_SERVER_S3_SECRET_KEY=
# S3VAULT_SERVER_S3_REGION=us-east-1
# S3VAULT_SERVER_S3_BUCKET=my-bucket  # virtual bucket; default = s3.bucket
# S3VAULT_SERVER_S3_BUCKET_AS_PREFIX=false  # true = client bucket becomes a key prefix

# --- multipart (S3 facade) ---
# The client decides when it needs multipart and how big its parts are; the
# gateway assembles whatever it is sent. Both knobs are writer-side choices, not
# negotiated ones, and nothing here changes what a client must be able to do.
#
# S3VAULT_S3_MULTIPART_PART_SIZE is bytes of one part. Bounds are S3's own: at
# least 5242880 (5 MiB) for every part but the last, at most 5368709120 (5 GiB).
# A body of at most one part is sent as a single PutObject and opens no session
# at all, so this value is also the threshold above which multipart starts.
# Bigger parts mean fewer round trips and more throughput, at the price of memory:
# the SDK keeps concurrency+1 buffers of exactly this size, so the 5 MiB default
# costs roughly 30 MiB in flight at concurrency 5, and every MiB you add here
# adds ~5 MiB there. Bigger parts mean fewer round trips; raise it only if the
# memory has somewhere to go.
# 0 = не задано, берётся дефолт. Любое другое значение вне диапазона —
# отказ на старте, с именем ключа в сообщении.
# S3VAULT_S3_MULTIPART_PART_SIZE=5242880
#
# S3VAULT_SERVER_MULTIPART_DIR is the spool of uploaded parts and is NOT
# cache.dir: the cache may be disabled while multipart must always work.
# Plaintext lands there (as in the cache), and assembly peaks at roughly twice the
# object size, so give it local disk with room to spare.
# S3VAULT_SERVER_MULTIPART_DIR=/var/cache/s3vault/multipart
# S3VAULT_SERVER_MULTIPART_TTL=24h             # session idle time before the sweeper drops it
# S3VAULT_SERVER_MULTIPART_SWEEP_INTERVAL=15m   # 0 = disable the sweeper
# S3VAULT_SERVER_MULTIPART_MAX_SESSIONS=64     # over the limit, the least recently used goes
# S3VAULT_SERVER_MULTIPART_MAX_BYTES=0         # per-session spool budget; 0 = unlimited

# --- client without CryptoPro: point s3.* at the gateway S3 facade ---
# A host without CryptoPro/S3 sets S3VAULT_S3_ENDPOINT to the gateway and uses
# the gateway's server.s3_access_key/server.s3_secret_key as S3 credentials,
# with S3VAULT_S3_PATH_STYLE=true. archive/upload/download then all work
# through the gateway. remote.url / S3VAULT_SERVER_TOKEN were removed.

# --- archive / upload defaults ---
# S3VAULT_ARCHIVE_OLDER_THAN=7d
# S3VAULT_ARCHIVE_WORKERS=4
# S3VAULT_ARCHIVE_ON_CHANGE=overwrite
# S3VAULT_ARCHIVE_FOLLOW_SYMLINKS=false
# S3VAULT_ARCHIVE_FAIL_FAST=false
# S3VAULT_ARCHIVE_DELETE_AFTER_UPLOAD=false
# S3VAULT_ARCHIVE_DELETE_IF_EXISTS=false
